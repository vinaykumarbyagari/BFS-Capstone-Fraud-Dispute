{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaseRecommendation",
  "description": "Advisory output contract for the fraud investigation agent. Validated before any model output is accepted.",
  "type": "object",
  "required": ["route", "priority", "confidence", "summary", "reasons", "policyCitations", "evidenceRequests", "abstained"],
  "additionalProperties": false,
  "properties": {
    "route": {
      "type": "string",
      "enum": ["RECOMMEND_REFUND", "RECOMMEND_DENIAL", "REQUEST_EVIDENCE", "ESCALATE_FRAUD_OPS", "MANUAL_REVIEW"]
    },
    "priority": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 1},
    "reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "policyCitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policyId"],
        "additionalProperties": false,
        "properties": {
          "policyId": {"type": "string"},
          "policyVersion": {"type": "string"},
          "section": {"type": "string"},
          "title": {"type": "string"},
          "score": {"type": "number"},
          "snippet": {"type": "string"}
        }
      }
    },
    "evidenceRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "abstained": {"type": "boolean"},
    "abstainReason": {"type": ["string", "null"]}
  }
}
