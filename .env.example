# Anthropic Claude API (leave empty -> processors run in deterministic rules mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: gateway/proxy root URL instead of default api.anthropic.com
ANTHROPIC_BASE_URL=

# Processor selection: auto | rules | springai | langchain4j
# "auto" prefers Spring AI when ANTHROPIC_API_KEY is set, else rules mode
FRAUD_PROCESSOR_MODE=auto

# Seeded staff accounts (change in production)
ANALYST_PASSWORD=analyst123
REVIEWER_PASSWORD=reviewer123
